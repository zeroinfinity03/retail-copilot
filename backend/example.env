# Copy this file to `.env` in the same folder, then fill in your actual keys.
# `.env` is gitignored — never commit your real keys.

OPENAI_API_KEY=sk-...                # used when backend/agents/llm.py selects openai
DEEPSEEK_API_KEY=sk-...              # used when backend/agents/llm.py selects deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com

PERPLEXITY_API_KEY=pplx-...          # used by the web research agent (Sonar Pro)
