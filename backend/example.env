# Copy this file to `.env` in the same folder, then paste your real keys after each `=`.
# `.env` is gitignored (never commit real keys). This template is safe to commit.

# --- Required at runtime ---
DEEPSEEK_API_KEY=                          # main LLM (llm.py: LLM_PROVIDER="deepseek")
DEEPSEEK_BASE_URL=https://api.deepseek.com
PERPLEXITY_API_KEY=                        # web research agent (Perplexity Sonar Pro)

# --- Optional: only if you switch the LLM provider ---
OPENAI_API_KEY=                            # used when llm.py LLM_PROVIDER="openai"

# --- Optional: only to (re)download the H&M dataset from Kaggle ---
KAGGLE_USERNAME=
KAGGLE_KEY=
