# DuckDB warehouse (~1.1 GB).
# DEMO (Option A): DB is BAKED into the image, so this line stays COMMENTED OUT.
# PROD (Option B): un-comment the line below to exclude it and download from S3 on startup instead.
# data/curated/

# raw source CSVs, only needed to BUILD the warehouse, not to run it
data/raw/

# local virtualenv + Python caches (the image builds its own venv)
.venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/

# secrets, injected at runtime via --env-file, never baked into the image
.env
example.env

# the Dockerfile itself + git noise
Dockerfile
.dockerignore
.git/
